# Copy to .env and fill in. Never commit the real .env (Engineering Rules §8).

# --- Database ---------------------------------------------------------
# Supabase connection string, asyncpg dialect.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/crm
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth (staff JWT) ---------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS — two independent allow-lists, JSON array syntax -------------
# This repo's own Next.js CRM dashboard origin(s).
CORS_DASHBOARD_ORIGINS=["http://localhost:3000"]
# The external, separately-maintained lead-capture site's origin(s) —
# coordinate with that repo's maintainers, never guess or wildcard.
CORS_PUBLIC_LEAD_ORIGINS=["https://www.alliance-domain.example"]

# --- Rate limiting (public endpoint only) -------------------------------
RATE_LIMIT_LEADS_PER_MINUTE=10

# --- Firebase Auth ----------------------------------------------------
# Path to the Firebase Admin SDK private key JSON (downloaded from Firebase
# Console → Project Settings → Service accounts → Generate new private key).
# Supports absolute paths (C:/path/to/key.json) or relative (from backend/ dir).
# Example (relative): FIREBASE_ADMIN_CRED_PATH=firebase-service-account.json
# Place the actual JSON file in backend/ and never commit it (.gitignore).
FIREBASE_ADMIN_CRED_PATH=

# --- Email notifications (optional — notifications are skipped, logged,
# and never block the lead write if unset) ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
STAFF_NOTIFICATION_EMAIL=
